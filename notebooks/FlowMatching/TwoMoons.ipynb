        "for epoch in range(epochs):\n",
        "  optimizer.zero_grad()\n",
        "\n",
        "  x1, y = sample_moons(batch_size) # Sample from observed data\n",
        "  loss = compute_loss_with_conditioning(network, x1, y)\n",
        "\n",
        "  loss.backward()\n",
        "  optimizer.step()\n",
        "\n",
        "  if epoch % 1000 == 0:\n",
        "    print(f\"Epoch {epoch:04d} | Loss: {loss.item():.4f}\")"
