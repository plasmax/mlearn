      },
      "source": [
        "## Sampling\n",
        "\n",
        "Start with Gaussian noise:\n",
        "\n",
        "$x_0 ∼ p$\n",
        "\n",
        "Predict the velocity vector field along the timesteps from 0 -> 1"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 452
        },
        "id": "lTESsj6Gv1It",
        "outputId": "5d3b8cf8-c228-4dce-abcd-869e15cd18bf"
      },
      "outputs": [
        {
          "data": {
            "image/png": "\n",
            "text/plain": [
              "<Figure size 640x480 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "@torch.no_grad()\n",
        "def sample_from_flow(network, num_samples=1000, steps=50):\n",
        "  network.eval()\n",
        "  # Start with pure Gaussian noise at t=0\n",
        "  xt = torch.randn((num_samples, 2))\n",
        "  dt = 1.0 / steps\n",
        "\n",
        "  # Euler integration loop\n",
        "  for i in range(steps):\n",
        "    # Current time t scaled between 0.0 and 1.0\n",
        "    t_val = i * dt\n",
        "    t_tensor = torch.full((num_samples, 1), t_val)\n",
        "\n",
        "    # Compute velocity field and move sample forward\n",
        "    vt = network(xt, t_tensor)\n",
        "\n",
        "    # Euler's method\n",
        "    xt = xt + vt * dt\n",
        "  return xt.numpy()\n",
        "\n",
        "generated_moons = sample_from_flow(network, num_samples=2000, steps=50)\n",
        "\n",
        "plt.scatter(generated_moons[:, 0], generated_moons[:, 1], s=5, alpha=0.6, color=\"purple\")\n",
        "plt.title(\"Generated Samples from Flow Matching Model\")\n",
        "plt.axis(\"equal\")\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "aEEE5BONu9DP"
      },
      "source": [
        "### An example alternative to Euler's method:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 452
        },
        "id": "x1jEeky7M3Dv",
        "outputId": "f519708d-d3ad-4fbe-8403-addcb05d998d"
      },
      "outputs": [
        {
          "data": {
            "image/png": "\n",
            "text/plain": [
              "<Figure size 640x480 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "@torch.no_grad()\n",
        "def midpoint_method(network, num_samples=1000, steps=50):\n",
        "  network.eval()\n",
        "  # Start with pure Gaussian noise at t=0\n",
        "  xt = torch.randn((num_samples, 2))\n",
        "  time_steps = torch.linspace(0.0, 1.0, steps+1)\n",
        "\n",
        "  # Midpoint integration loop\n",
        "  for i in range(steps):\n",
        "    # Current time t scaled between 0.0 and 1.0\n",
        "\n",
        "    # Midpoint method\n",
        "    t_start = time_steps[i].view(1, 1).expand(xt.shape[0], 1)\n",
        "    t_end = time_steps[i + 1]\n",
        "    dt = t_end - t_start\n",
        "    vt_start = network(xt, t_start)\n",
        "    vt_mid = network(xt + vt_start * dt / 2, t_start + dt / 2)\n",
        "    xt = xt + dt * vt_mid\n",
        "  return xt.numpy()\n",
        "\n",
        "generated_moons = midpoint_method(network, num_samples=2000, steps=50)\n",
        "\n",
        "plt.scatter(generated_moons[:, 0], generated_moons[:, 1], s=5, alpha=0.6, color=\"purple\")\n",
        "plt.title(\"Generated Samples from Flow Matching Model\")\n",
        "plt.axis(\"equal\")\n",
        "plt.show()"
      ]
    },
