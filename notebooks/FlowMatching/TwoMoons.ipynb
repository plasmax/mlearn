      ],
      "source": [
        "for step in range(steps):\n",
        "  optimizer.zero_grad()\n",
        "\n",
        "  x1, _ = sample_moons(batch_size) # Sample from observed data\n",
        "  loss = compute_loss(network, x1)\n",
        "\n",
        "  loss.backward()\n",
        "  optimizer.step()\n",
        "\n",
        "  if step % 1000 == 0:\n",
        "    print(f\"Steps {step:04d} | Loss: {loss.item():.4f}\")"
      ]
    },
