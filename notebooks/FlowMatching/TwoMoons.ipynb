      "source": [
        "import numpy as np\n",
        "import torch\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from matplotlib.animation import FuncAnimation\n",
        "from matplotlib.colors import Normalize\n",
        "from IPython.display import HTML\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def record_flow_trajectory(network, label, num_samples=512, steps=50):\n",
        "    network.eval()\n",
        "\n",
        "    parameter = next(network.parameters())\n",
        "    device = parameter.device\n",
        "    dtype = parameter.dtype\n",
        "\n",
        "    xt = torch.randn(num_samples, 2, device=device, dtype=dtype)\n",
        "    y = torch.full(\n",
        "        (num_samples,),\n",
        "        label,\n",
        "        dtype=torch.long,\n",
        "        device=device,\n",
        "    )\n",
        "\n",
        "    dt = 1.0 / steps\n",
        "    trajectory = [xt.float().cpu().numpy()]\n",
        "\n",
        "    for i in range(steps):\n",
        "        t = torch.full(\n",
        "            (num_samples, 1),\n",
        "            i * dt,\n",
        "            device=device,\n",
        "            dtype=dtype,\n",
        "        )\n",
        "\n",
        "        velocity = network(xt, t, y)\n",
        "        xt = xt + velocity * dt\n",
        "\n",
        "        trajectory.append(xt.float().cpu().numpy())\n",
        "\n",
        "    return np.stack(trajectory)  # [steps + 1, samples, 2]\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def predict_grid_velocity(\n",
        "    network,\n",
        "    label,\n",
        "    grid,\n",
        "    steps=50,\n",
        "):\n",
        "    network.eval()\n",
        "\n",
        "    parameter = next(network.parameters())\n",
        "    device = parameter.device\n",
        "    dtype = parameter.dtype\n",
        "\n",
        "    x = torch.as_tensor(grid, device=device, dtype=dtype)\n",
        "    y = torch.full(\n",
        "        (len(grid),),\n",
        "        label,\n",
        "        dtype=torch.long,\n",
        "        device=device,\n",
        "    )\n",
        "\n",
        "    fields = []\n",
        "\n",
        "    for i in range(steps + 1):\n",
        "        t_value = i / steps\n",
        "\n",
        "        t = torch.full(\n",
        "            (len(grid), 1),\n",
        "            t_value,\n",
        "            device=device,\n",
        "            dtype=dtype,\n",
        "        )\n",
        "\n",
        "        velocity = network(x, t, y)\n",
        "        fields.append(velocity.float().cpu().numpy())\n",
        "\n",
        "    return np.stack(fields)  # [steps + 1, grid_points, 2]\n",
        "\n",
        "\n",
        "def animate_conditional_flow(\n",
        "    network,\n",
        "    num_samples=512,\n",
        "    steps=50,\n",
        "    grid_size=21,\n",
        "    interval=100,\n",
        "    quiver_scale=12,\n",
        "):\n",
        "    trajectories = {\n",
        "        0: record_flow_trajectory(network, 0, num_samples, steps),\n",
        "        1: record_flow_trajectory(network, 1, num_samples, steps),\n",
        "    }\n",
        "\n",
        "    # Use fixed limits so the plot does not jump.\n",
        "    all_positions = np.concatenate(\n",
        "        [trajectory.reshape(-1, 2) for trajectory in trajectories.values()]\n",
        "    )\n",
        "\n",
        "    x_min, y_min = all_positions.min(axis=0)\n",
        "    x_max, y_max = all_positions.max(axis=0)\n",
        "\n",
        "    margin = 0.5\n",
        "    x_min, x_max = x_min - margin, x_max + margin\n",
        "    y_min, y_max = y_min - margin, y_max + margin\n",
        "\n",
        "    grid_x, grid_y = np.meshgrid(\n",
        "        np.linspace(x_min, x_max, grid_size),\n",
        "        np.linspace(y_min, y_max, grid_size),\n",
        "    )\n",
        "\n",
        "    grid = np.column_stack([grid_x.ravel(), grid_y.ravel()])\n",
        "\n",
        "    fields = {\n",
        "        0: predict_grid_velocity(network, 0, grid, steps),\n",
        "        1: predict_grid_velocity(network, 1, grid, steps),\n",
        "    }\n",
        "\n",
        "    all_magnitudes = np.concatenate([\n",
        "        np.linalg.norm(field, axis=-1).ravel()\n",
        "        for field in fields.values()\n",
        "    ])\n",
        "\n",
        "    magnitude_norm = Normalize(\n",
        "        vmin=0,\n",
        "        vmax=all_magnitudes.max(),\n",
        "    )\n",
        "\n",
        "    fig, axes = plt.subplots(\n",
        "        1,\n",
        "        2,\n",
        "        figsize=(13, 6),\n",
        "        constrained_layout=True,\n",
        "    )\n",
        "\n",
        "    point_colours = {0: \"red\", 1: \"blue\"}\n",
        "    scatters = {}\n",
        "    quivers = {}\n",
        "\n",
        "    for label, ax in enumerate(axes):\n",
        "        position = trajectories[label][0]\n",
        "        velocity = fields[label][0]\n",
        "        magnitude = np.linalg.norm(velocity, axis=-1)\n",
        "\n",
        "        scatters[label] = ax.scatter(\n",
        "            position[:, 0],\n",
        "            position[:, 1],\n",
        "            s=8,\n",
        "            alpha=0.6,\n",
        "            color=point_colours[label],\n",
        "        )\n",
        "\n",
        "        quivers[label] = ax.quiver(\n",
        "            grid[:, 0],\n",
        "            grid[:, 1],\n",
        "            velocity[:, 0],\n",
        "            velocity[:, 1],\n",
        "            magnitude,\n",
        "            cmap=\"viridis\",\n",
        "            norm=magnitude_norm,\n",
        "            angles=\"xy\",\n",
        "            scale_units=\"xy\",\n",
        "            scale=quiver_scale,\n",
        "            pivot=\"mid\",\n",
        "        )\n",
        "\n",
        "        ax.set_xlim(x_min, x_max)\n",
        "        ax.set_ylim(y_min, y_max)\n",
        "        ax.set_aspect(\"equal\", adjustable=\"box\")\n",
        "        ax.set_xlabel(\"$x_1$\")\n",
        "        ax.set_ylabel(\"$x_2$\")\n",
        "        ax.set_title(f\"Condition $y={label}$\")\n",
        "\n",
        "    fig.colorbar(\n",
        "        quivers[0],\n",
        "        ax=axes,\n",
        "        label=r\"Velocity magnitude $\\|v_\\theta(x_t,t,y)\\|$\",\n",
        "        shrink=0.8,\n",
        "    )\n",
        "\n",
        "    time_text = fig.suptitle(\"\")\n",
        "\n",
        "    def update(frame):\n",
        "        for label in (0, 1):\n",
        "            position = trajectories[label][frame]\n",
        "            velocity = fields[label][frame]\n",
        "            magnitude = np.linalg.norm(velocity, axis=-1)\n",
        "\n",
        "            scatters[label].set_offsets(position)\n",
        "\n",
        "            quivers[label].set_UVC(\n",
        "                velocity[:, 0],\n",
        "                velocity[:, 1],\n",
        "                magnitude,\n",
        "            )\n",
        "\n",
        "        time_text.set_text(\n",
        "            f\"Flow matching sampling: step {frame}/{steps}, \"\n",
        "            f\"$t={frame / steps:.2f}$\"\n",
        "        )\n",
        "\n",
        "        return [\n",
        "            scatters[0],\n",
        "            scatters[1],\n",
        "            quivers[0],\n",
        "            quivers[1],\n",
        "            time_text,\n",
        "        ]\n",
        "\n",
        "    animation = FuncAnimation(\n",
        "        fig,\n",
        "        update,\n",
        "        frames=steps + 1,\n",
        "        interval=interval,\n",
        "        blit=False,\n",
        "    )\n",
        "\n",
        "    plt.close(fig)\n",
        "    return animation"
      ]
    },
