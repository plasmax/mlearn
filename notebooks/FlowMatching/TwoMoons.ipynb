      "source": [
        "# Flow Matching basics\n",
        "\n",
        "Learn a velocity vector field that transforms a sample from a gaussian noise distribution to a complex target distribution - in this case, the simple Two Moons dataset."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "####Imports"
      ],
      "metadata": {
        "id": "fpKW7pBiCUGw"
      }
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "IPqm6eNsmUAZ"
      },
      "outputs": [],
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import make_moons\n",
        "\n",
        "def sample_moons(batch_size=512):\n",
        "  \"\"\"Generates standard x1 target data points from the Two Moons distribution.\"\"\"\n",
        "  x, y = make_moons(n_samples=batch_size, noise=0.05)\n",
        "  return torch.tensor(x, dtype=torch.float32), torch.tensor(y, dtype=torch.long)\n"
      ]
    },
