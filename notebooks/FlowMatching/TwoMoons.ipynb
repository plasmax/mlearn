      "source": [
        "@torch.no_grad()\n",
        "def sample_from_flow_conditionally(network, label, num_samples=1000, steps=50):\n",
        "  network.eval()\n",
        "  # Start with pure Gaussian noise at t=0\n",
        "  xt = torch.randn((num_samples, 2))\n",
        "  y = torch.full(\n",
        "      (num_samples,),\n",
        "      label,\n",
        "      dtype=torch.long,\n",
        "      device=xt.device\n",
        "  )\n",
        "  dt = 1.0 / steps\n",
        "\n",
        "  # Euler integration loop\n",
        "  for i in range(steps):\n",
        "    # Current time t scaled between 0.0 and 1.0\n",
        "    t_val = i * dt\n",
        "    t_tensor = torch.full((num_samples, 1), t_val)\n",
        "\n",
        "    # Compute velocity field and move sample forward\n",
        "    velocity = network(xt, t_tensor, y)\n",
        "\n",
        "    # Euler's method\n",
        "    xt = xt + velocity * dt\n",
        "  return xt.numpy()\n",
        "\n",
        "generated_moons_red  = sample_from_flow_conditionally(network, 0, num_samples=512, steps=50)\n",
        "generated_moons_blue = sample_from_flow_conditionally(network, 1, num_samples=512, steps=50)\n",
        "\n",
        "plt.scatter(generated_moons_red[:, 0], generated_moons_red[:, 1], s=5, alpha=0.6, color=\"red\")\n",
        "plt.scatter(generated_moons_blue[:, 0], generated_moons_blue[:, 1], s=5, alpha=0.6, color=\"blue\")\n",
        "plt.title(\"Generated Samples from Flow Matching Model\")\n",
        "plt.axis(\"equal\")\n",
        "plt.show()"
      ]
    },
